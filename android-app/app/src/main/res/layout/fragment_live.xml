<?xml version="1.0" encoding="utf-8"?>
<!-- Live match screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="@dimen/gt_spacing_md">
    <!-- Score header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="@dimen/gt_spacing_xl">
        <TextView android:id="@+id/textHomeTeam" style="@style/GT.Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" />
        <TextView android:id="@+id/textScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gt_green_accent" android:textSize="@dimen/gt_text_xl" android:textStyle="bold" android:layout_marginHorizontal="@dimen/gt_spacing_xl" />
        <TextView android:id="@+id/textAwayTeam" style="@style/GT.Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
    </LinearLayout>
    <!-- Match report scroll -->
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:id="@+id/textReport" style="@style/GT.Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </ScrollView>
</LinearLayout>
