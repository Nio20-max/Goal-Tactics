<?xml version="1.0" encoding="utf-8"?>
<!-- Mail/Messages screen matching original mailstable.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/gt_spacing_md">

    <!-- Table header -->
    <LinearLayout
        style="@style/GT.Row.Header"
        android:orientation="horizontal">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
            android:text="Date" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
            android:text="From" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="5"
            android:text="Subject" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/textNoMail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="No emails"
        android:textColor="@color/gt_text_secondary"
        android:textSize="@dimen/gt_text_body"
        android:visibility="gone" />

</LinearLayout>
