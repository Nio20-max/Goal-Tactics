<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base game theme - matches original GTTheme -->
    <style name="Theme.GoalTactics" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/colorText</item>
        <item name="colorPrimaryDark">@color/colorGray</item>
        <item name="colorAccent">@color/colorAccentGreen</item>
        <item name="colorSecondary">@color/colorAccentGreen</item>
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:textColorHint">@color/colorGray</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColorPrimary">@color/gt_text_primary</item>
        <item name="android:textColorSecondary">@color/gt_text_secondary</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <!-- Login-specific theme - same base, no action bar -->
    <style name="Theme.GoalTactics.Login">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Game button style (green, rounded) -->
    <style name="GT.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">@dimen/gt_button_height</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">@dimen/gt_button_width</item>
        <item name="android:textColor">@color/gt_text_primary</item>
        <item name="android:textSize">@dimen/gt_text_body</item>
        <item name="backgroundTint">@color/gt_button_primary</item>
        <item name="cornerRadius">@dimen/gt_corner_radius</item>
    </style>

    <style name="GT.Button.Small">
        <item name="android:layout_height">@dimen/gt_button_height_small</item>
        <item name="android:textSize">@dimen/gt_text_sm</item>
        <item name="android:minWidth">80dp</item>
    </style>

    <style name="GT.Button.Danger">
        <item name="backgroundTint">@color/gt_button_danger</item>
    </style>

    <style name="GT.Button.Secondary">
        <item name="backgroundTint">@color/gt_button_secondary</item>
    </style>

    <!-- Text styles -->
    <style name="GT" parent="">
    </style>

    <style name="GT.Text">
        <item name="android:textColor">@color/gt_text_primary</item>
        <item name="android:textSize">@dimen/gt_text_body</item>
    </style>

    <style name="GT.Text.Title">
        <item name="android:textColor">@color/gt_text_primary</item>
        <item name="android:textSize">@dimen/gt_text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GT.Text.Body">
        <item name="android:textColor">@color/gt_text_primary</item>
        <item name="android:textSize">@dimen/gt_text_body</item>
    </style>

    <style name="GT.Text.Secondary">
        <item name="android:textColor">@color/gt_text_secondary</item>
        <item name="android:textSize">@dimen/gt_text_sm</item>
    </style>

    <style name="GT.Text.Small">
        <item name="android:textColor">@color/gt_text_secondary</item>
        <item name="android:textSize">@dimen/gt_text_xs</item>
    </style>

    <style name="GT.Text.Currency">
        <item name="android:textSize">@dimen/gt_text_sm</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GT.Text.Currency.Money">
        <item name="android:textColor">@color/gt_money_green</item>
    </style>

    <style name="GT.Text.Currency.Stars">
        <item name="android:textColor">@color/gt_stars_yellow</item>
    </style>

    <style name="GT.Text.Currency.Medipacks">
        <item name="android:textColor">@color/gt_medipacks_blue</item>
    </style>

    <!-- Input fields -->
    <style name="GT.EditText" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:textColor">@color/gt_text_primary</item>
        <item name="android:textColorHint">@color/gt_text_disabled</item>
        <item name="android:textSize">@dimen/gt_text_body</item>
        <item name="android:background">@color/gt_background_panel</item>
    </style>

    <!-- Table row styles -->
    <style name="GT.Row">
        <item name="android:layout_height">@dimen/gt_row_height</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:paddingStart">@dimen/gt_row_padding_h</item>
        <item name="android:paddingEnd">@dimen/gt_row_padding_h</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="GT.Row.Header">
        <item name="android:background">@color/gt_green_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Card style -->
    <style name="GT.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/gt_background_panel</item>
        <item name="cardCornerRadius">@dimen/gt_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/gt_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Popup / dialog -->
    <style name="GT.Dialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@color/gt_background_panel</item>
        <item name="android:textColorPrimary">@color/gt_text_primary</item>
    </style>
</resources>
