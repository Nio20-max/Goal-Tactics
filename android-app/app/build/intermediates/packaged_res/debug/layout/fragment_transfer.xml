<?xml version="1.0" encoding="utf-8"?>
<!-- Transfer market: 4 tabs matching original (Search result/Quick search/Bids & Favourites/My auctions) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Tab bar -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        style="@style/GT.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tabbar_height"
        android:background="@drawable/navigationbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Tab 0: Search Result -->
        <LinearLayout
            android:id="@+id/panelSearchResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Table header -->
            <LinearLayout
                style="@style/GT.Row.Header"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="4"
                    android:text="@string/squad_name" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="@string/squad_position" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/squad_strength" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="@string/transfer_min_bid" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="@string/transfer_end_date" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTransfers"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Tab 1: Quick Search (2-column layout matching original) -->
        <LinearLayout
            android:id="@+id/panelQuickSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="@dimen/gt_spacing_md"
            android:visibility="visible">

            <!-- Left: Position picker + sliders -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="@dimen/gt_spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose position"
                    style="@style/GT.Text.Body" />

                <Spinner
                    android:id="@+id/spinnerPosition"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/gt_button_height_sm"
                    android:layout_marginTop="@dimen/gt_spacing_sm"
                    android:background="@drawable/bg_input_field" />

                <!-- Age range -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gt_spacing_lg"
                    android:text="Age"
                    style="@style/GT.Text.Body" />

                <TextView
                    android:id="@+id/textAgeRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="16 - 34"
                    style="@style/GT.Text.Secondary" />

                <!-- Strength range -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gt_spacing_lg"
                    android:text="Strength"
                    style="@style/GT.Text.Body" />

                <TextView
                    android:id="@+id/textStrengthRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 - Max"
                    style="@style/GT.Text.Secondary" />

                <Button
                    android:id="@+id/btnReset"
                    style="@style/GT.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/gt_button_height_sm"
                    android:layout_marginTop="@dimen/gt_spacing_lg"
                    android:text="Reset" />
            </LinearLayout>

            <!-- Right: Budget switch + talent + search -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="@dimen/gt_spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set budget as limit"
                    style="@style/GT.Text.Body" />

                <Switch
                    android:id="@+id/switchBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gt_spacing_sm"
                    android:text="No"
                    android:textColor="@color/gt_text_primary" />

                <!-- Talent range -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gt_spacing_lg"
                    android:text="Talent"
                    style="@style/GT.Text.Body" />

                <TextView
                    android:id="@+id/textTalentRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 - 10"
                    style="@style/GT.Text.Secondary" />

                <Button
                    android:id="@+id/btnSearch"
                    style="@style/GT.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/gt_button_height_sm"
                    android:layout_marginTop="@dimen/gt_spacing_lg"
                    android:text="@string/search" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tab 2: Bids / Favourites -->
        <LinearLayout
            android:id="@+id/panelBidsFavourites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                style="@style/GT.Row.Header"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="4"
                    android:text="@string/squad_name" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="@string/squad_position" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/squad_strength" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="Your bid" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerBids"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Tab 3: My Auctions -->
        <LinearLayout
            android:id="@+id/panelMyAuctions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                style="@style/GT.Row.Header"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="4"
                    android:text="@string/squad_name" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="@string/squad_position" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="Current bid" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="@string/transfer_end_date" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMyAuctions"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
