<?xml version="1.0" encoding="utf-8"?>
<!-- Club info screen: tabs + 3-pane horizontal like legacy clubinfonew.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Tab bar -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        style="@style/GT.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tabbar_height"
        android:background="@drawable/navigationbar" />

    <!-- My Club tab content (3-pane) -->
    <LinearLayout
        android:id="@+id/panelMyClub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Left: Team stats (weight 3) -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3">
            <LinearLayout
                android:id="@+id/panelStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/gt_spacing_sm">
                <include layout="@layout/item_stat_row" android:id="@+id/rowTeamName" />
                <include layout="@layout/item_stat_row" android:id="@+id/rowCountry" />
                <include layout="@layout/item_stat_row" android:id="@+id/rowLeague" />
                <include layout="@layout/item_stat_row" android:id="@+id/rowMarketValue" />
                <include layout="@layout/item_stat_row" android:id="@+id/rowMood" />
                <include layout="@layout/item_stat_row" android:id="@+id/rowStrength" />
                <include layout="@layout/item_stat_row" android:id="@+id/rowWins" />
                <include layout="@layout/item_stat_row" android:id="@+id/rowLosses" />
                <include layout="@layout/item_stat_row" android:id="@+id/rowFans" />
            </LinearLayout>
        </ScrollView>

        <!-- Center: Stadium + match info (weight 4) -->
        <RelativeLayout
            android:id="@+id/panelStadium"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4">

            <!-- Stadium image -->
            <ImageView
                android:id="@+id/imgStadium"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/stadium1"
                android:scaleType="fitStart"
                android:contentDescription="" />

            <!-- Club logo -->
            <ImageView
                android:id="@+id/imgClubLogo"
                android:layout_width="@dimen/teamview_logo_size"
                android:layout_height="@dimen/teamview_logo_size"
                android:layout_marginTop="@dimen/teamview_margin_top"
                android:layout_centerHorizontal="true"
                android:src="@drawable/wappen01_normal"
                android:contentDescription="" />

            <!-- Club name -->
            <TextView
                android:id="@+id/textClubName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_above="@+id/textSeasonInfo"
                style="@style/GT.Text.Title" />

            <!-- Season info -->
            <TextView
                android:id="@+id/textSeasonInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_above="@+id/btnLastMatch"
                style="@style/GT.Text.Secondary" />

            <!-- Divider for button split -->
            <View
                android:id="@+id/clubInfoMatchDivider"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_centerInParent="true" />

            <!-- Last Match / Next Match toggle buttons -->
            <Button
                android:id="@+id/btnLastMatch"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Last Match"
                android:textSize="10sp"
                android:layout_above="@+id/matchContainer"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/clubInfoMatchDivider"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/subtab_selector"
                android:textColor="@color/colorText" />

            <Button
                android:id="@+id/btnNextMatch"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Next Match"
                android:textSize="10sp"
                android:layout_above="@+id/matchContainer"
                android:layout_toEndOf="@+id/clubInfoMatchDivider"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/subtab_selector"
                android:textColor="@color/colorText" />

            <!-- Match info bottom panel -->
            <RelativeLayout
                android:id="@+id/matchContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/teamview_matchcontainer_height"
                android:layout_alignParentBottom="true"
                android:background="@drawable/background_darktransparent">

                <!-- Home logo -->
                <ImageView
                    android:id="@+id/matchHomeLogo"
                    android:layout_width="@dimen/teamview_matchlogo_size"
                    android:layout_height="@dimen/teamview_matchlogo_size"
                    android:src="@drawable/wappen01_normal"
                    android:layout_alignParentStart="true"
                    android:contentDescription="" />

                <!-- Away logo -->
                <ImageView
                    android:id="@+id/matchAwayLogo"
                    android:layout_width="@dimen/teamview_matchlogo_size"
                    android:layout_height="@dimen/teamview_matchlogo_size"
                    android:src="@drawable/wappen01_normal"
                    android:layout_alignParentEnd="true"
                    android:contentDescription="" />

                <!-- Score / status -->
                <TextView
                    android:id="@+id/matchStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/colorAccentBlue"
                    android:text="0:0"
                    android:layout_alignTop="@+id/matchHomeLogo"
                    android:layout_toEndOf="@+id/matchHomeLogo"
                    android:layout_toStartOf="@+id/matchAwayLogo"
                    style="@style/GT.Text.Body" />

                <!-- Match date -->
                <TextView
                    android:id="@+id/matchDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/colorAccentBlue"
                    android:layout_alignBottom="@+id/matchHomeLogo"
                    android:layout_toEndOf="@+id/matchHomeLogo"
                    android:layout_toStartOf="@+id/matchAwayLogo"
                    style="@style/GT.Text.Secondary" />

                <!-- Home team name -->
                <TextView
                    android:id="@+id/matchHomeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:background="@drawable/background_darktransparent"
                    android:padding="2dp"
                    android:layout_below="@+id/matchHomeLogo"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/matchAwayLogo"
                    style="@style/GT.Text.Secondary" />

                <!-- Away team name -->
                <TextView
                    android:id="@+id/matchAwayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:background="@drawable/background_darktransparent"
                    android:padding="2dp"
                    android:layout_below="@+id/matchAwayLogo"
                    android:layout_toEndOf="@+id/matchHomeLogo"
                    android:layout_alignParentEnd="true"
                    style="@style/GT.Text.Secondary" />

                <!-- Lineup button -->
                <Button
                    android:id="@+id/btnLineup"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="Lineup"
                    android:textSize="10sp"
                    android:layout_below="@+id/matchHomeName"
                    android:layout_alignStart="@+id/matchHomeName"
                    android:layout_alignEnd="@+id/matchHomeName"
                    android:background="@drawable/background_green"
                    android:textColor="@color/colorText" />

                <!-- Compare button -->
                <Button
                    android:id="@+id/btnCompare"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="Compare"
                    android:textSize="10sp"
                    android:layout_below="@+id/matchAwayName"
                    android:layout_alignStart="@+id/matchAwayName"
                    android:layout_alignEnd="@+id/matchAwayName"
                    android:background="@drawable/background_green"
                    android:textColor="@color/colorText" />
            </RelativeLayout>
        </RelativeLayout>

        <!-- Right: Club news (weight 3) -->
        <LinearLayout
            android:id="@+id/panelNews"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:padding="@dimen/gt_spacing_sm">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerNews"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sponsors tab content -->
    <LinearLayout
        android:id="@+id/panelSponsors"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/gt_spacing_md"
        android:visibility="gone">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSponsors"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Inbox tab content -->
    <LinearLayout
        android:id="@+id/panelInbox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/gt_spacing_md"
        android:visibility="gone">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerInbox"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Accomplishments tab content -->
    <LinearLayout
        android:id="@+id/panelAccomplishments"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/gt_spacing_md"
        android:visibility="gone">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAccomplishments"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>
