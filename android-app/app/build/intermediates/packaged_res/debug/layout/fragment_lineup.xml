<?xml version="1.0" encoding="utf-8"?>
<!-- Lineup screen with formation field + player list, matching original lineupformation.xml -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lineupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Soccer field background -->
    <ImageView
        android:id="@+id/imgField"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/soccerfield"
        android:scaleType="fitXY"
        android:contentDescription=""
        app:layout_constraintTop_toBottomOf="@+id/lineupControls"
        app:layout_constraintBottom_toTopOf="@+id/benchArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/playerListPanel" />

    <!-- Player list on the right (weight ~250dp like original) -->
    <LinearLayout
        android:id="@+id/playerListPanel"
        android:layout_width="250dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/background_dark_nocorners"
        android:padding="@dimen/gt_spacing_sm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Match selector -->
        <Spinner
            android:id="@+id/spinnerMatch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gt_button_height"
            android:layout_marginBottom="@dimen/gt_spacing_sm" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerLineupPlayers"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Controls bar at top -->
    <LinearLayout
        android:id="@+id/lineupControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/gt_spacing_sm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/playerListPanel">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tactics"
            style="@style/GT.Text.Secondary"
            android:layout_marginEnd="@dimen/gt_spacing_sm" />

        <Spinner
            android:id="@+id/spinnerTactic"
            android:layout_width="@dimen/lineupformation_combobox_width"
            android:layout_height="@dimen/lineupformation_combobox_height" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System"
            style="@style/GT.Text.Secondary"
            android:layout_marginStart="@dimen/gt_spacing_md"
            android:layout_marginEnd="@dimen/gt_spacing_sm" />

        <Spinner
            android:id="@+id/spinnerSystem"
            android:layout_width="@dimen/lineupformation_combobox_width"
            android:layout_height="@dimen/lineupformation_combobox_height" />
    </LinearLayout>

    <!-- Formation position slots (11 field positions added programmatically) -->
    <FrameLayout
        android:id="@+id/formationSlots"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/lineupControls"
        app:layout_constraintBottom_toTopOf="@+id/benchArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/playerListPanel" />

    <!-- Strength display -->
    <TextView
        android:id="@+id/textStrength"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Strength: 0"
        android:textColor="@color/colorHighlight"
        android:layout_marginBottom="@dimen/gt_spacing_sm"
        app:layout_constraintBottom_toTopOf="@+id/benchArea"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/gt_spacing_sm"
        style="@style/GT.Text.Body" />

    <!-- Locked banner -->
    <TextView
        android:id="@+id/textLocked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LOCKED"
        android:textColor="@color/colorHighlight"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/gt_spacing_sm"
        app:layout_constraintBottom_toTopOf="@+id/benchArea"
        app:layout_constraintEnd_toStartOf="@+id/playerListPanel"
        android:layout_marginEnd="@dimen/gt_spacing_sm"
        style="@style/GT.Text.Body" />

    <!-- Bench area -->
    <LinearLayout
        android:id="@+id/benchArea"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@drawable/background_greenwithstroke"
        android:gravity="center"
        android:padding="@dimen/gt_spacing_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/playerListPanel">

        <!-- 6 bench positions added programmatically -->
    </LinearLayout>

    <!-- Save button -->
    <Button
        android:id="@+id/btnSave"
        style="@style/GT.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/playerListPanel"
        android:layout_margin="@dimen/gt_spacing_sm" />
</androidx.constraintlayout.widget.ConstraintLayout>
