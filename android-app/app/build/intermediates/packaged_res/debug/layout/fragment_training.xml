<?xml version="1.0" encoding="utf-8"?>
<!-- Training screen with tabs for team/individual/tactic/camp training -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Tab header -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        style="@style/GT.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tabbar_height"
        android:background="@drawable/navigationbar" />

    <!-- Team training content -->
    <LinearLayout
        android:id="@+id/teamTrainingPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/gt_spacing_md">

        <!-- Left: skill selection -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_main_skill"
                style="@style/GT.Text.Body"
                android:layout_marginBottom="@dimen/gt_spacing_sm" />

            <Spinner
                android:id="@+id/spinnerMainSkill"
                android:layout_width="match_parent"
                android:layout_height="@dimen/gt_button_height"
                android:layout_marginBottom="@dimen/gt_spacing_lg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_sub_skill"
                style="@style/GT.Text.Body"
                android:layout_marginBottom="@dimen/gt_spacing_sm" />

            <Spinner
                android:id="@+id/spinnerSubSkill"
                android:layout_width="match_parent"
                android:layout_height="@dimen/gt_button_height"
                android:layout_marginBottom="@dimen/gt_spacing_lg" />

            <TextView
                android:id="@+id/textEfficiency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/GT.Text.Body"
                android:layout_marginBottom="@dimen/gt_spacing_lg" />

            <ProgressBar
                android:id="@+id/progressEfficiency"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progressDrawable="@drawable/progress_bar_green"
                android:max="100"
                android:layout_marginBottom="@dimen/gt_spacing_xl" />

            <Button
                android:id="@+id/btnSaveTraining"
                style="@style/GT.Button"
                android:layout_width="match_parent"
                android:text="@string/training_save" />
        </LinearLayout>

        <!-- Right: training camp -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/gt_spacing_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/training_camp"
                style="@style/GT.Text.Title"
                android:layout_marginBottom="@dimen/gt_spacing_md" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCamps"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
