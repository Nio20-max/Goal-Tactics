<?xml version="1.0" encoding="utf-8"?>
<!-- League: 4 tabs (League/Matches/Fixture list/Goalscorers' list) matching original -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        style="@style/GT.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tabbar_height"
        android:background="@drawable/navigationbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Tab 0: League table -->
        <LinearLayout
            android:id="@+id/panelLeague"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Table header -->
            <LinearLayout
                style="@style/GT.Row.Header"
                android:orientation="horizontal">
                <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="Pos." android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:text="Club" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="45dp" android:layout_height="wrap_content" android:text="Str" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="25dp" android:layout_height="wrap_content" android:text="W" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="25dp" android:layout_height="wrap_content" android:text="D" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="25dp" android:layout_height="wrap_content" android:text="L" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="GL" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="35dp" android:layout_height="wrap_content" android:text="GD" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="35dp" android:layout_height="wrap_content" android:text="Pts." android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerLeague"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Tab 1: Matches -->
        <LinearLayout
            android:id="@+id/panelMatches"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMatches"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Tab 2: Fixture list -->
        <LinearLayout
            android:id="@+id/panelFixtures"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerFixtures"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Tab 3: Goalscorers' list -->
        <LinearLayout
            android:id="@+id/panelGoalscorers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerGoalscorers"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
