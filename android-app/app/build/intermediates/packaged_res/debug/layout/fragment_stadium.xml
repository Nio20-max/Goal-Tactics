<?xml version="1.0" encoding="utf-8"?>
<!-- Stadium screen with build places grid -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="@dimen/gt_spacing_md">

    <!-- Left: Stadium info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView style="@style/GT.Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/nav_stadium" android:layout_marginBottom="@dimen/gt_spacing_md" />

        <include layout="@layout/item_stat_row" android:id="@+id/rowStadiumName" />
        <include layout="@layout/item_stat_row" android:id="@+id/rowCapacity" />
        <include layout="@layout/item_stat_row" android:id="@+id/rowGrassQuality" />
        <include layout="@layout/item_stat_row" android:id="@+id/rowEarnings" />

        <View android:layout_width="match_parent" android:layout_height="@dimen/gt_spacing_xl" />

        <Button android:id="@+id/btnRenewGrass" style="@style/GT.Button" android:layout_width="match_parent"
            android:text="@string/stadium_renew_grass" android:layout_marginBottom="@dimen/gt_spacing_md" />
        <Button android:id="@+id/btnRename" style="@style/GT.Button.Secondary" android:layout_width="match_parent"
            android:text="@string/stadium_rename" />
    </LinearLayout>

    <!-- Right: Build places grid -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/gt_spacing_xl">

        <TextView style="@style/GT.Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/stadium_build" android:layout_marginBottom="@dimen/gt_spacing_md" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBuildPlaces"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>
