<?xml version="1.0" encoding="utf-8"?>
<!-- Friends: 3 tabs (Friends list/Challenges/Search friends) matching original -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        style="@style/GT.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tabbar_height"
        android:background="@drawable/navigationbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Tab 0: Friends list -->
        <LinearLayout
            android:id="@+id/panelFriendsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerFriends"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Empty state (hidden when friends exist) -->
            <LinearLayout
                android:id="@+id/noFriendsContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/characters_manager01"
                    android:scaleType="fitCenter"
                    android:contentDescription="" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gt_spacing_lg"
                    android:text="You have no friends yet."
                    style="@style/GT.Text.Body" />

                <Button
                    android:id="@+id/btnSearchFriendsEmpty"
                    style="@style/GT.Button"
                    android:layout_width="@dimen/gt_button_width"
                    android:layout_height="@dimen/gt_button_height_sm"
                    android:layout_marginTop="@dimen/gt_spacing_lg"
                    android:text="Search friends" />

                <Button
                    android:id="@+id/btnFriendInvite"
                    style="@style/GT.Button.Secondary"
                    android:layout_width="@dimen/gt_button_width"
                    android:layout_height="@dimen/gt_button_height_sm"
                    android:layout_marginTop="@dimen/gt_spacing_md"
                    android:text="Friend invite" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tab 1: Challenges -->
        <LinearLayout
            android:id="@+id/panelChallenges"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerChallenges"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Tab 2: Search friends -->
        <LinearLayout
            android:id="@+id/panelSearchFriends"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/gt_spacing_md"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/gt_spacing_md">

                <EditText
                    android:id="@+id/editSearch"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gt_button_height_small"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/friends_search_hint"
                    android:inputType="text"
                    android:padding="@dimen/gt_spacing_sm"
                    android:textColor="@color/gt_text_primary"
                    android:textColorHint="@color/gt_text_disabled"
                    android:textSize="@dimen/gt_text_sm" />

                <Button
                    android:id="@+id/btnSearchFriends"
                    style="@style/GT.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gt_spacing_md"
                    android:text="@string/search" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSearchResults"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
