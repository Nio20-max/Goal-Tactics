<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: 2 tabs (Settings/Notifications) with 2-pane layout matching original -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Tab bar -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        style="@style/GT.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tabbar_height"
        android:background="@drawable/navigationbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Tab 0: Settings (2-pane: left=Facebook, right=account settings) -->
        <LinearLayout
            android:id="@+id/panelSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="visible">

            <!-- Left pane: Facebook connect -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/gt_spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect with Facebook"
                    android:layout_marginBottom="@dimen/gt_spacing_lg"
                    style="@style/GT.Text.Body" />

                <ImageView
                    android:id="@+id/profilePicture"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginBottom="@dimen/gt_spacing_lg"
                    android:src="@drawable/com_facebook_button_like_icon_selected"
                    android:scaleType="fitCenter"
                    android:contentDescription="Profile" />

                <Button
                    android:id="@+id/btnFacebook"
                    style="@style/GT.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/gt_button_height_sm"
                    android:text="Continue with Facebook" />
            </LinearLayout>

            <!-- Right pane: Account settings -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/gt_spacing_lg">

                    <TextView
                        android:id="@+id/textManagerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/gt_spacing_lg"
                        style="@style/GT.Text.Title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/gt_spacing_md">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Music" style="@style/GT.Text.Body" />
                        <Switch android:id="@+id/switchMusic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gt_text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/gt_spacing_lg">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sound" style="@style/GT.Text.Body" />
                        <Switch android:id="@+id/switchSound" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gt_text_primary" />
                    </LinearLayout>

                    <Button android:id="@+id/btnUpdateAccount" style="@style/GT.Button" android:layout_width="match_parent" android:layout_height="@dimen/gt_button_height_sm" android:layout_marginBottom="@dimen/gt_spacing_md" android:text="Update account" />
                    <Button android:id="@+id/btnDailyReward" style="@style/GT.Button.Secondary" android:layout_width="match_parent" android:layout_height="@dimen/gt_button_height_sm" android:layout_marginBottom="@dimen/gt_spacing_md" android:text="@string/settings_daily_reward" />
                    <Button android:id="@+id/btnMoreApps" style="@style/GT.Button.Secondary" android:layout_width="match_parent" android:layout_height="@dimen/gt_button_height_sm" android:layout_marginBottom="@dimen/gt_spacing_md" android:text="More apps" />
                    <Button android:id="@+id/btnPrivacyPolicy" style="@style/GT.Button.Secondary" android:layout_width="match_parent" android:layout_height="@dimen/gt_button_height_sm" android:layout_marginBottom="@dimen/gt_spacing_md" android:text="Privacy policy" />
                    <Button android:id="@+id/btnLogout" style="@style/GT.Button.Secondary" android:layout_width="match_parent" android:layout_height="@dimen/gt_button_height_sm" android:layout_marginBottom="@dimen/gt_spacing_md" android:text="@string/settings_logout" />
                    <Button android:id="@+id/btnDeleteAccount" style="@style/GT.Button.Danger" android:layout_width="match_parent" android:layout_height="@dimen/gt_button_height_sm" android:text="@string/settings_delete_account" />
                    <TextView android:id="@+id/textVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gt_spacing_lg" android:gravity="center" style="@style/GT.Text.Small" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Tab 1: Notifications -->
        <ScrollView
            android:id="@+id/panelNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/gt_spacing_lg"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <CheckBox android:id="@+id/checkAuctionOverbid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auction Overbid" android:textColor="@color/gt_text_primary" />
                <CheckBox android:id="@+id/checkMatchResults" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Match Results" android:textColor="@color/gt_text_primary" />
                <CheckBox android:id="@+id/checkLineupIncomplete" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lineup Incomplete" android:textColor="@color/gt_text_primary" />
                <CheckBox android:id="@+id/checkFriendInvite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Friend Invite" android:textColor="@color/gt_text_primary" />
                <CheckBox android:id="@+id/checkIneffectiveTraining" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ineffective Training" android:textColor="@color/gt_text_primary" />
                <CheckBox android:id="@+id/checkFriendlyMatch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Friendly Match" android:textColor="@color/gt_text_primary" />
                <CheckBox android:id="@+id/checkSystem" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="System" android:textColor="@color/gt_text_primary" />
                <CheckBox android:id="@+id/checkAuctionEnd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auction End" android:textColor="@color/gt_text_primary" />
                <Button android:id="@+id/btnSavePrefs" style="@style/GT.Button" android:layout_width="match_parent" android:layout_height="@dimen/gt_button_height_sm" android:layout_marginTop="@dimen/gt_spacing_lg" android:text="@string/save" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
