<?xml version="1.0" encoding="utf-8"?>
<!-- Menu item matching original mainmenucell.xml: icon + text on menu_row background -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/menu_cell_height"
    android:background="@drawable/menu_row_selector"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <ImageView
        android:id="@+id/imgNavIcon"
        android:layout_width="@dimen/menu_image_size"
        android:layout_height="@dimen/menu_image_size"
        android:scaleType="fitCenter"
        android:contentDescription="" />

    <TextView
        android:id="@+id/textNavItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:textColor="@color/colorText"
        android:textSize="@dimen/gt_text_body"
        android:textStyle="bold"
        android:shadowColor="@color/colorShadow"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2" />
</LinearLayout>
