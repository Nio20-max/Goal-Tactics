<?xml version="1.0" encoding="utf-8"?>
<!-- Scouting: 2 tabs (Instruct scout/Youth player) matching original -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        style="@style/GT.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tabbar_height"
        android:background="@drawable/navigationbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Tab 0: Instruct scout (2-column: normal scout | special scout) -->
        <LinearLayout
            android:id="@+id/panelInstructScout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Info text -->
            <TextView
                android:id="@+id/textScoutingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/gt_spacing_md"
                android:text="Instruct a scout to find youth players."
                style="@style/GT.Text.Body" />

            <!-- Two-column scout instructions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- Left: Normal scout -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/gt_spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INSTRUCT SCOUT"
                        android:textStyle="bold"
                        style="@style/GT.Text.Body" />

                    <ImageView
                        android:id="@+id/imgNormalScout"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginTop="@dimen/gt_spacing_md"
                        android:src="@drawable/characters_manager01"
                        android:scaleType="fitCenter"
                        android:contentDescription="" />

                    <TextView
                        android:id="@+id/textNormalTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gt_spacing_md"
                        android:text="Time left:"
                        style="@style/GT.Text.Secondary" />

                    <Button
                        android:id="@+id/btnInstructNormal"
                        style="@style/GT.Button"
                        android:layout_width="@dimen/gt_button_width"
                        android:layout_height="@dimen/gt_button_height_sm"
                        android:layout_marginTop="@dimen/gt_spacing_md"
                        android:text="Instruct" />
                </LinearLayout>

                <!-- Separator -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/gt_separator" />

                <!-- Right: Special scout -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/gt_spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INSTRUCT SPECIAL SCOUT"
                        android:textStyle="bold"
                        style="@style/GT.Text.Body" />

                    <ImageView
                        android:id="@+id/imgSpecialScout"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginTop="@dimen/gt_spacing_md"
                        android:src="@drawable/characters_manager01"
                        android:scaleType="fitCenter"
                        android:contentDescription="" />

                    <Spinner
                        android:id="@+id/spinnerPosition"
                        android:layout_width="@dimen/gt_button_width"
                        android:layout_height="@dimen/gt_button_height_sm"
                        android:layout_marginTop="@dimen/gt_spacing_md"
                        android:background="@drawable/bg_input_field" />

                    <TextView
                        android:id="@+id/textSpecialTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gt_spacing_md"
                        android:text="Time left:"
                        style="@style/GT.Text.Secondary" />

                    <Button
                        android:id="@+id/btnSpeedUp"
                        style="@style/GT.Button.Secondary"
                        android:layout_width="@dimen/gt_button_width"
                        android:layout_height="@dimen/gt_button_height_sm"
                        android:layout_marginTop="@dimen/gt_spacing_sm"
                        android:text="Speed up" />

                    <Button
                        android:id="@+id/btnInstructSpecial"
                        style="@style/GT.Button"
                        android:layout_width="@dimen/gt_button_width"
                        android:layout_height="@dimen/gt_button_height_sm"
                        android:layout_marginTop="@dimen/gt_spacing_sm"
                        android:text="Instruct" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Tab 1: Youth player -->
        <LinearLayout
            android:id="@+id/panelYouthPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerYouthPlayers"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
