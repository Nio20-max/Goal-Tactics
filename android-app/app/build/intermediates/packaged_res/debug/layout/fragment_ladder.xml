<?xml version="1.0" encoding="utf-8"?>
<!-- GT Ladder: 2 tabs (Ladder/Rewards) matching original -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        style="@style/GT.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tabbar_height"
        android:background="@drawable/navigationbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Tab 0: Ladder table -->
        <LinearLayout
            android:id="@+id/panelLadder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Table header -->
            <LinearLayout
                style="@style/GT.Row.Header"
                android:orientation="horizontal">
                <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="Pos." android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="4" android:text="Club" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="Strength" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="GL" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="GD" android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="Pts." android:gravity="center" android:textColor="@color/white" android:textSize="@dimen/gt_text_xs" android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerLadder"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Tab 1: Rewards -->
        <LinearLayout
            android:id="@+id/panelRewards"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/gt_spacing_md"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRewards"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
