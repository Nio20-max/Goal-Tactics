<?xml version="1.0" encoding="utf-8"?>
<!-- Live match screen - matches original liveview.xml layout -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Green gradient at top -->
    <View
        android:id="@+id/topGradient"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:background="@color/gt_green_accent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Score background -->
    <View
        android:id="@+id/scoreBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/background_darktransparent"
        app:layout_constraintTop_toTopOf="@id/textScore"
        app:layout_constraintBottom_toBottomOf="@id/textScore"
        app:layout_constraintStart_toStartOf="@id/textScore"
        app:layout_constraintEnd_toEndOf="@id/textScore" />

    <!-- Score text centered -->
    <TextView
        android:id="@+id/textScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gt_spacing_sm"
        android:paddingHorizontal="24dp"
        android:paddingVertical="@dimen/gt_spacing_sm"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/topGradient"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Home logo -->
    <ImageView
        android:id="@+id/imgHomeLogo"
        android:layout_width="50dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/gt_spacing_sm"
        android:scaleType="fitCenter"
        android:src="@drawable/wappen01_normal"
        android:contentDescription="Home logo"
        app:layout_constraintTop_toTopOf="@id/textScore"
        app:layout_constraintBottom_toBottomOf="@id/textScore"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Home team name -->
    <TextView
        android:id="@+id/textHomeTeam"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/gt_spacing_sm"
        android:textColor="@color/gt_text_primary"
        android:textSize="@dimen/gt_text_body"
        app:layout_constraintTop_toTopOf="@id/textScore"
        app:layout_constraintBottom_toBottomOf="@id/textScore"
        app:layout_constraintStart_toEndOf="@id/imgHomeLogo"
        app:layout_constraintEnd_toStartOf="@id/textScore" />

    <!-- Away team name -->
    <TextView
        android:id="@+id/textAwayTeam"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="@dimen/gt_spacing_sm"
        android:textColor="@color/gt_text_primary"
        android:textSize="@dimen/gt_text_body"
        app:layout_constraintTop_toTopOf="@id/textScore"
        app:layout_constraintBottom_toBottomOf="@id/textScore"
        app:layout_constraintStart_toEndOf="@id/textScore"
        app:layout_constraintEnd_toStartOf="@id/imgAwayLogo" />

    <!-- Away logo -->
    <ImageView
        android:id="@+id/imgAwayLogo"
        android:layout_width="50dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/gt_spacing_sm"
        android:scaleType="fitCenter"
        android:src="@drawable/wappen02_normal"
        android:contentDescription="Away logo"
        app:layout_constraintTop_toTopOf="@id/textScore"
        app:layout_constraintBottom_toBottomOf="@id/textScore"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Match time -->
    <TextView
        android:id="@+id/textMatchTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gt_spacing_md"
        android:background="@drawable/background_darktransparent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="2dp"
        android:textColor="@color/gt_green_accent"
        android:textSize="@dimen/gt_text_sm"
        app:layout_constraintTop_toBottomOf="@id/textScore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tab buttons for Game Course / Players / Statistics -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gt_spacing_md"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/textMatchTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnGameCourse"
            style="@style/GT.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Game Course" />

        <Button
            android:id="@+id/btnPlayers"
            style="@style/GT.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gt_spacing_sm"
            android:text="Players" />

        <Button
            android:id="@+id/btnStatistics"
            style="@style/GT.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gt_spacing_sm"
            android:text="Statistics" />
    </LinearLayout>

    <!-- Match events list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEvents"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gt_spacing_sm"
        android:clipToPadding="false"
        android:padding="@dimen/gt_spacing_md"
        app:layout_constraintTop_toBottomOf="@id/tabBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Fallback report text (hidden when recycler is populated) -->
    <ScrollView
        android:id="@+id/scrollReport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gt_spacing_sm"
        android:padding="@dimen/gt_spacing_md"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tabBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gt_text_primary"
            android:textSize="@dimen/gt_text_sm" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
