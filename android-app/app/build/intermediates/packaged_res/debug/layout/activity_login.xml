<?xml version="1.0" encoding="utf-8"?>
<!-- Login activity: 3-page flow matching original (Create Team → Login → Register) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== PAGE 0: Create Team / Quick Start (initial screen) ===== -->
    <RelativeLayout
        android:id="@+id/pageCreateTeam"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Background image -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/background"
            android:scaleType="centerCrop"
            android:contentDescription="" />

        <!-- Top bar -->
        <TextView
            android:id="@+id/topBarCreate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gt_top_bar_height"
            android:layout_alignParentTop="true"
            android:background="@drawable/tab_middle_inactive"
            android:gravity="center"
            android:text="What should your team be called?"
            android:textColor="@color/gt_text_primary"
            android:textSize="@dimen/gt_text_body"
            android:textStyle="bold"
            android:shadowColor="@color/colorShadow"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <!-- Content centered -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/topBarCreate"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/gt_spacing_lg">

            <!-- Team name input -->
            <EditText
                android:id="@+id/editTeamName"
                android:layout_width="300dp"
                android:layout_height="@dimen/gt_input_height"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:hint="Your team name"
                android:inputType="text"
                android:maxLength="32"
                android:imeOptions="flagNoExtractUi"
                android:textColor="@color/gt_text_primary"
                android:textColorHint="@color/gt_text_disabled"
                android:textSize="@dimen/gt_text_body" />

            <!-- Country selector -->
            <ImageView
                android:id="@+id/imgCountrySelect"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="@dimen/gt_spacing_lg"
                android:src="@drawable/flag_de"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Select country" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gt_spacing_sm"
                android:text="Select a country"
                android:textColor="@color/gt_text_secondary"
                android:textSize="@dimen/gt_text_sm" />

            <!-- Let's start button -->
            <Button
                android:id="@+id/btnStart"
                style="@style/GT.Button"
                android:layout_width="@dimen/gt_button_width"
                android:layout_height="@dimen/gt_button_height_sm"
                android:layout_marginTop="@dimen/gt_spacing_lg"
                android:text="Let&apos;s start" />

            <!-- Sign in/Sign up link -->
            <Button
                android:id="@+id/btnGoToLogin"
                style="@style/GT.Button.Secondary"
                android:layout_width="@dimen/gt_button_width"
                android:layout_height="@dimen/gt_button_height_sm"
                android:layout_marginTop="@dimen/gt_spacing_md"
                android:text="Sign in/Sign up" />
        </LinearLayout>

        <!-- Bottom right: Privacy policy + version -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/gt_spacing_sm">

            <Button
                android:id="@+id/btnPrivacyPolicy"
                style="@style/GT.Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Privacy policy"
                android:textSize="@dimen/gt_text_xs" />

            <TextView
                android:id="@+id/textVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gt_spacing_sm"
                android:textColor="@color/gt_text_disabled"
                android:textSize="@dimen/gt_text_xs" />
        </LinearLayout>

        <!-- Help button top-right -->
        <ImageButton
            android:id="@+id/btnHelpCreate"
            android:layout_width="@dimen/round_button_size"
            android:layout_height="@dimen/round_button_size"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:background="@drawable/button_helpshift_selector"
            android:contentDescription="Help" />
    </RelativeLayout>

    <!-- ===== PAGE 1: Login (reached from Sign in/Sign up) ===== -->
    <RelativeLayout
        android:id="@+id/pageLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Background image -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/background"
            android:scaleType="centerCrop"
            android:contentDescription="" />

        <!-- Top bar -->
        <TextView
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gt_top_bar_height"
            android:layout_alignParentTop="true"
            android:background="@drawable/tab_middle_inactive"
            android:gravity="center"
            android:text="@string/login_button"
            android:textColor="@color/gt_text_primary"
            android:textSize="@dimen/gt_text_body"
            android:textStyle="bold"
            android:shadowColor="@color/colorShadow"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <!-- Dual pane content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/login_buttonsStack"
            android:layout_below="@id/topBar"
            android:orientation="horizontal">

            <!-- LEFT PANE: Facebook button (matches original registerFacebook) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/gt_spacing_lg">

                <Button
                    android:id="@+id/btnFacebook"
                    style="@style/GT.Button"
                    android:layout_width="@dimen/gt_button_width"
                    android:layout_height="@dimen/gt_button_height_sm"
                    android:text="Continue with Facebook"
                    android:drawableStart="@drawable/com_facebook_button_like_icon_selected"
                    android:drawablePadding="8dp" />
            </LinearLayout>

            <!-- RIGHT PANE: Sign in form -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/gt_spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:paddingBottom="@dimen/gt_spacing_sm"
                        android:text="Sign in with a manager name and a password"
                        android:textColor="@color/gt_text_primary"
                        android:textSize="@dimen/gt_text_sm" />

                    <EditText
                        android:id="@+id/editEmail"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/gt_input_height"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center"
                        android:hint="@string/login_manager_name_hint"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="textPersonName"
                        android:maxLength="64"
                        android:nextFocusDown="@id/editPassword"
                        android:textColor="@color/gt_text_primary"
                        android:textColorHint="@color/gt_text_disabled"
                        android:textSize="@dimen/gt_text_body" />

                    <EditText
                        android:id="@+id/editPassword"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/gt_input_height"
                        android:layout_marginTop="@dimen/gt_spacing_md"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center"
                        android:hint="@string/login_password_hint"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="textPassword"
                        android:maxLength="128"
                        android:textColor="@color/gt_text_primary"
                        android:textColorHint="@color/gt_text_disabled"
                        android:textSize="@dimen/gt_text_body" />

                    <!-- Error message -->
                    <TextView
                        android:id="@+id/textError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gt_spacing_sm"
                        android:gravity="center"
                        android:textColor="@color/gt_text_error"
                        android:textSize="@dimen/gt_text_sm"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnLogin"
                        style="@style/GT.Button"
                        android:layout_width="@dimen/gt_button_width"
                        android:layout_height="@dimen/gt_button_height_sm"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/gt_spacing_md"
                        android:text="@string/login_button" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom buttons: Support / Quick start / New player -->
        <LinearLayout
            android:id="@+id/login_buttonsStack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:paddingTop="@dimen/gt_spacing_md"
            android:paddingBottom="@dimen/gt_spacing_md">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <Button
                    android:id="@+id/btnSupport"
                    style="@style/GT.Button.Secondary"
                    android:layout_width="@dimen/gt_button_width"
                    android:layout_height="@dimen/gt_button_height_sm"
                    android:layout_gravity="center"
                    android:text="@string/login_support" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <Button
                    android:id="@+id/btnQuickStart"
                    style="@style/GT.Button"
                    android:layout_width="@dimen/gt_button_width"
                    android:layout_height="@dimen/gt_button_height_sm"
                    android:layout_gravity="center"
                    android:text="@string/login_quickstart" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <Button
                    android:id="@+id/btnRegister"
                    style="@style/GT.Button.Secondary"
                    android:layout_width="@dimen/gt_button_width"
                    android:layout_height="@dimen/gt_button_height_sm"
                    android:layout_gravity="center"
                    android:text="@string/login_new_player" />
            </FrameLayout>
        </LinearLayout>

        <!-- Help button top-right -->
        <ImageButton
            android:id="@+id/btnHelpLogin"
            android:layout_width="@dimen/round_button_size"
            android:layout_height="@dimen/round_button_size"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:background="@drawable/button_helpshift_selector"
            android:contentDescription="Help" />
    </RelativeLayout>

    <!-- ===== PAGE 2: Register (reached from New player) ===== -->
    <RelativeLayout
        android:id="@+id/pageRegister"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Background image -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/background"
            android:scaleType="centerCrop"
            android:contentDescription="" />

        <!-- Character image (matches original main_character) -->
        <ImageView
            android:id="@+id/imgCharacter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/gt_top_bar_height"
            android:src="@drawable/characters_manager01"
            android:scaleType="fitCenter"
            android:contentDescription="" />

        <!-- Top bar -->
        <TextView
            android:id="@+id/topBarRegister"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gt_top_bar_height"
            android:layout_alignParentTop="true"
            android:background="@drawable/tab_middle_inactive"
            android:gravity="center"
            android:text="The first step towards your very own club!"
            android:textColor="@color/gt_text_primary"
            android:textSize="@dimen/gt_text_body"
            android:textStyle="bold"
            android:shadowColor="@color/colorShadow"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <!-- Centered register form (matches original userDataContainer) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/topBarRegister">

            <LinearLayout
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="@dimen/gt_spacing_lg">

                <EditText
                    android:id="@+id/editRegManagerName"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/gt_input_height"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center"
                    android:hint="Your manager name"
                    android:inputType="textPersonName"
                    android:maxLength="64"
                    android:imeOptions="flagNoExtractUi"
                    android:textColor="@color/gt_text_primary"
                    android:textColorHint="@color/gt_text_disabled"
                    android:textSize="@dimen/gt_text_body" />

                <EditText
                    android:id="@+id/editRegEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/gt_input_height"
                    android:layout_marginTop="@dimen/gt_spacing_md"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center"
                    android:hint="Your e-mail"
                    android:inputType="textEmailAddress"
                    android:maxLength="128"
                    android:imeOptions="flagNoExtractUi"
                    android:textColor="@color/gt_text_primary"
                    android:textColorHint="@color/gt_text_disabled"
                    android:textSize="@dimen/gt_text_body" />

                <EditText
                    android:id="@+id/editRegPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/gt_input_height"
                    android:layout_marginTop="@dimen/gt_spacing_md"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:maxLength="128"
                    android:imeOptions="flagNoExtractUi"
                    android:textColor="@color/gt_text_primary"
                    android:textColorHint="@color/gt_text_disabled"
                    android:textSize="@dimen/gt_text_body" />

                <EditText
                    android:id="@+id/editRegPasswordConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/gt_input_height"
                    android:layout_marginTop="@dimen/gt_spacing_md"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center"
                    android:hint="Repeat password"
                    android:inputType="textPassword"
                    android:maxLength="128"
                    android:imeOptions="flagNoExtractUi"
                    android:textColor="@color/gt_text_primary"
                    android:textColorHint="@color/gt_text_disabled"
                    android:textSize="@dimen/gt_text_body" />

                <!-- Error text -->
                <TextView
                    android:id="@+id/textRegError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gt_spacing_sm"
                    android:gravity="center"
                    android:textColor="@color/gt_text_error"
                    android:textSize="@dimen/gt_text_sm"
                    android:visibility="gone" />

                <!-- Cancel / Next buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gt_spacing_md"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRegCancel"
                        style="@style/GT.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/gt_button_height_sm"
                        android:layout_marginEnd="@dimen/gt_spacing_sm"
                        android:layout_weight="1"
                        android:text="Cancel" />

                    <Button
                        android:id="@+id/btnDoRegister"
                        style="@style/GT.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/gt_button_height_sm"
                        android:layout_marginStart="@dimen/gt_spacing_sm"
                        android:layout_weight="1"
                        android:text="Next" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Help button top-right -->
        <ImageButton
            android:id="@+id/btnHelpRegister"
            android:layout_width="@dimen/round_button_size"
            android:layout_height="@dimen/round_button_size"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:background="@drawable/button_helpshift_selector"
            android:contentDescription="Help" />
    </RelativeLayout>

    <!-- Loading overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gt_background_overlay"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</FrameLayout>
