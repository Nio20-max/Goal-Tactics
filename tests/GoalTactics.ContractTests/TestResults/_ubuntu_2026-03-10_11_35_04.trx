info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (10ms) [Parameters=[@p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      SELECT "c0"."id" AS "Id", "c0"."user_id" AS "UserId", "c0"."message" AS "Message", "c0"."created_at" AS "CreatedAtUtc", "u"."manager_name" AS "UserName"
      FROM (
          SELECT "c"."id", "c"."created_at", "c"."message", "c"."user_id"
          FROM "chat_messages" AS "c"
          ORDER BY "c"."created_at" DESC
          LIMIT @p
      ) AS "c0"
      INNER JOIN "users" AS "u" ON "c0"."user_id" = "u"."id"
      ORDER BY "c0"."created_at" DESC
