info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[], CommandType='Text', CommandTimeout='30']
      SELECT "l"."id", "l"."country", "l"."draws_away", "l"."draws_home", "l"."goals_received_away", "l"."goals_received_home", "l"."goals_scored_away", "l"."goals_scored_home", "l"."is_bot", "l"."is_online", "l"."league_id", "l"."logo", "l"."losses_away", "l"."losses_home", "l"."matches_away", "l"."matches_home", "l"."points_away", "l"."points_home", "l"."strength", "l"."team_id", "l"."team_name", "l"."wins_away", "l"."wins_home", "l0"."id", "l0"."dismount", "l0"."group_number", "l0"."mount", "l0"."name", "l0"."tier"
      FROM "league_teams" AS "l"
      INNER JOIN "leagues" AS "l0" ON "l"."league_id" = "l0"."id"
      WHERE "l0"."tier" = 3 AND "l"."is_bot" AND "l"."team_id" IS NOT NULL
      ORDER BY "l0"."group_number", "l"."team_name"
      LIMIT 1
