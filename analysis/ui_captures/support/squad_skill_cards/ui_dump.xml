 resource-id="" class="android.view.View" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,136][855,189]" drawing-order="0" hint="" /><node index="1" text="What are Skill Cards?" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,207][855,238]" drawing-order="0" hint="" /><node index="2" text="Skill Cards can be used to boost your player's attributes persistently and helps you to become the best manager in Goal Tactics!  There are 3 different qualities for each Skill Card availble. All player skills are featured within these cards." resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,256][855,335]" drawing-order="0" hint="" /><node index="3" text="&#10;" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,333][855,361]" drawing-order="0" hint="" /><node index="4" text="Where can you find Skill Cards?" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,379][855,409]" drawing-order="0" hint="" /><node index="5" text="You can find Skill Cards during your daily gameplay routine. For now the cards can be earned in friendly matches or via sponsor contracts. We implemented a complex and innovative card drop mechanism to present you a diverse and rewarding game experience. We also currently working on a lot more ways to earn these cards and to benefit from the new, rare and cool consumables. Stay tuned." resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,427][855,558]" drawing-order="0" hint="" /><node index="6" text="&#10;" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,556][855,584]" drawing-order="0" hint="" /><node index="7" text="Different Qualities" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,602][855,632]" drawing-order="0" hint="" /><node index="8" text="Skill Cards are available in the different qualities, so you can find common, rare or even legendary Cards during gameplay. Better Cards have a higher effect for a player." resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[