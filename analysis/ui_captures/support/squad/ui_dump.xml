="false" selected="false" bounds="[136,316][855,344]" drawing-order="0" hint="" /><node index="5" text="&#10;" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,342][855,370]" drawing-order="0" hint="" /><node index="6" text="Age" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,368][855,396]" drawing-order="0" hint="" /><node index="7" text="The Players Age. The range goes from 16 to 34 years. If a player reaches an age of 34, he will leave your team at the end of the season, his contract can´t get extended. Players get older 1 year per season." resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,394][855,473]" drawing-order="0" hint="" /><node index="8" text="&#10;" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,471][855,499]" drawing-order="0" hint="" /><node index="9" text="Salary" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,497][855,525]" drawing-order="0" hint="" /><node index="10" text="The amount of money you have to spend for your player daily." resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,523][855,550]" drawing-order="0" hint="" /><node index="11" text="&#10;" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,548][855,576]" drawing-order="0" hint="" /><node index="12" text="Market value" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,574][855,602]" drawing-order="0" hint="" /><node index="13" text="A player's market value is calculated in light of all of his data. Talented young players will therefore tend to have a higher market value than comparable older and less talented players." resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,600][855,654]" drawing-order="0" hint="" /><node index="14" text="&#10;" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,652][855,679]" drawing-order="0" hint="" /><node index="15" text="Position" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,677][855,705]" drawing-order="0" hint="" /><node index="16" text="The place in your lineup, where this player is suited for best." resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,703][855,731]" drawing-order="0" hint="" /><node index="17" text="" resource-id="" class="android.view.View" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,729][855,757]" drawing-order="0" hint=""><node index="0" text="Goalkeeper" resource-id="" class="android.view.View" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,731][225,753]" drawing-order="0" hint="" /></node><node index="18" text="The goalkeeper requires good goal-keeping skills." resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,755][855,783]" drawing-order="0" hint="" /><node index="19" text="" resource-id="" class="android.view.View" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,781][855,808]" drawing-order="0" hint=""><node index="0" text="Defender" resource-id="" class="android.view.View" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,783][209,805]" drawing-order="0" hint="" /></node><node index="20" text="" resource-id="" class="android.view.View" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,806][855,886]" drawing-order="0" hint=""><node index="0" text="Central defenders require good defensive, heading, tackling and marking values. Full-backs don't need to be aerial powerhouses, but they should be able to deliver accurate crosses. " resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,808][823,856]" drawing-order="0" hint="" /><node index="1" text="Midfielder" resource-id="" class="android.view.View" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,860][214,882]" drawing-order="0" hint="" /></node><node index="21" text="Central midfielders are characterised by a good understanding of the game, ball control, reliable passing and strong tackling values. Left and right-sided midfielders are characterised less by tackles won and more by delicate crosses, which is how they help their team succeed." resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,884][855,963]" drawing-order="0" hint="" /><node index="22" text="" resource-id="" class="android.view.View" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,961][855,989]" drawing-order="0" hint=""><node index="0" text="Striker" resource-id="" class="android.view.View" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,963][187,985]" drawing-order="0" hint="" /></node><node index="23" text="Centre-forwards should always exhibit strong shooting, speed and good ball control. Wingers are less effective as outstanding headers, but are more useful in sending pin-point crosses in behind the defenders." resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,987][855,996]" drawing-order="0" hint="" /><node index="24" text="&#10;" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,996][855,996]" drawing-order="0" hint="" /><node index="25" text="Strength" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,996][855,996]" drawing-order="0" hint="" /><node index="26" text="The higher the strength of the player, the higher the team strength will be in a match. Squads with a higher team strength than their opponent will win more matches. " resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,996][855,996]" drawing-order="0" hint="" /><node index="27" text="&#10;" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,996][855,996]" drawing-order="0" hint="" /><node index="28" text="Quality" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,996][855,996]" drawing-order="0" hint="" /><node index="29" text="The Quality will be defined after comparing the Talent level, the age and the strength of the player. 