oaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,858][855,886]" drawing-order="0" hint="" /><node index="13" text="Normal:&#10;" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,901][855,929]" drawing-order="0" hint="" /><node index="14" text='Your team will act "normally". Every part of the team plays according to his strength and weaknesses, every party of the team is weight in the same percentage. Choose this tactic, if your team is not familiar with any other tactic or shall play more balanced.' resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,944][855,996]" drawing-order="0" hint="" /><node index="15" text=" " resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,996][855,996]" drawing-order="0" hint="" /><node index="16" text="Pressing:" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,996][855,996]" drawing-order="0" hint="" /><node index="17" text='Your team will tackle more often and aggressively, if "Pressing" is the tactic. You need high level midfield players, in order to play this tactic successfully, as the midfield quadrants receive a strength bonus of 18%. In contrast to that the attack quadrants will receive a malus of 8% and the defence quadrants a malus of 5%. ' resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,996][855,996]" drawing-order="0" hint="" /><node index="18" text="Required sub skills:  Speed / Tackling" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,996][855,996]" drawing-order="0" hint="" /><node index="19" text="Preferred quadrant: Midfield " resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,996][855,996]" drawing-order="0" hint="" /><node index="20" text="Counter attack:" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,996][855,996]" drawing-order="0" hint="" /><node index="21" text="Choosing the counter tactic will weaken your midfield quadrants by 18%, whereas the defence and attack quadrants receive a bonus of 12% each. " resource-id="" class="android.wi