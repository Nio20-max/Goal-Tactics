resource-id="" class="android.view.View" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,136][855,189]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.view.View" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,187][855,370]" drawing-order="0" hint=""><node index="0" text="The GT ladder is an independent league within the " resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,189][520,211]" drawing-order="0" hint="" /><node index="1" text="Goal Tactics Association" resource-id="" class="android.view.View" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[518,189][717,211]" drawing-order="0" hint="" /><node index="2" text=", which has no bearing on your regular game. Participants in the GT ladder do not generate income, nor suffer injuries or pick up cards that would affect their upcoming league matches. Your objective is to be right at the top of the league come the end of the GT ladder. If you finish a ladder in one of the top league positions, you will receive a prize. You can withdraw from a ladder at any time. You should note, however, that you will lose your entire points total and will not be able to rejoin a league for another 15 minutes." resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,189][852,366]" drawing-order="0" hint="" /></node><node index="2" text="&#10;" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,368][855,396]" drawing-order="0" hint="" /><node index="3" text="The process" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,394][855,421]" drawing-order="0" hint="" /><node index="4" text="A GT ladder lasts for one week; the start and end dates are given below the ladder selection. Each player can play five games within the GT ladder. First finalise your lineup, then join a ladder. This will be used as your standard lineup for ladder games. However, you can change the lineup at any time between matches. As soon as you have entered a ladder, you will be placed in the overall rankings. From there you can challenge any club by tapping on the rankings list. Ladder games are instantly played in time-lapse and last for 90 seconds." resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,419][855,576]" drawing-order="0" hint="" /><node index="5" text="&#10;" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,574][855,602]" drawing-order="0" hint="" /><node index="6" text="The ranking system" resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,600][855,628]" drawing-order="0" hint="" /><node index="7" text="The GT ladder is based on an ELO ranking system, as is used in other sports. Upon entering a ladder, your team will automatically be allotted a certain number of points, which will be the current average of all the other teams in the ladder. If you challenge a team, you will see the number of points you can expect from a win or a defeat. These points are calculated with the aid of the ELO formula using the points of both clubs. You can only gain or lose points when you are the challenger." resource-id="" class="android.widget.TextView" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[136,626][855,783]" drawing-order="0" hint="" /></node></node></node><node index="1" text="" resource-id="com.xyrality.goaltactics:id/question_footer" class="android.widget.LinearLayout" package="com.xyrality.goaltactics" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,996][872,1049]" drawing-order="2" hint=""><node index="0" text="" re