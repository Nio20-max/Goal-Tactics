<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:id="@+id/switcher_container"
    android:background="@drawable/switchbg2"
    android:layout_width="@dimen/gtswitcher_width"
    android:layout_height="@dimen/gtswitcher_height">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/switcher_text_no"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/Switcher_no"
        android:layout_marginStart="@dimen/gtswitcher_text_margin"
        android:layout_alignParentStart="true"
        style="@style/TextStyle"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/switcher_text_yes"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/Switcher_yes"
        android:layout_marginEnd="@dimen/gtswitcher_text_margin"
        android:layout_alignParentEnd="true"
        style="@style/TextStyle"/>
    <View
        android:id="@+id/switcher_handle"
        android:background="@drawable/switchhandle"
        android:layout_width="@dimen/gtswitcher_handle_width"
        android:layout_height="@dimen/gtswitcher_handle_height"
        android:layout_marginTop="1dp"/>
</RelativeLayout>
