<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:rowCount="7"
    android:columnCount="3">
    <RelativeLayout
        android:gravity="bottom|right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="0"
        android:layout_rowWeight="3"
        android:layout_columnWeight="3">
        <TextView
            android:textColor="@color/colorAccentGreen"
            android:id="@+id/homeName"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home team Name"
            android:maxLines="1"
            style="@style/TextStyle"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="bottom|left"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="2"
        android:layout_row="0"
        android:layout_rowWeight="3"
        android:layout_columnWeight="3">
        <TextView
            android:textColor="@color/colorAccentGreen"
            android:id="@+id/awayName"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Away team Name"
            android:maxLines="1"
            style="@style/TextStyle"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:padding="5dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="1"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <crc645877ad3d44b9b81b.GTProgressBar
            android:id="@+id/homePossession"
            android:layout_width="80dp"
            android:layout_height="25dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="1"
        android:layout_row="1"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <TextView
            android:textColor="@android:color/white"
            android:id="@+id/possessionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Possession"
            android:maxLines="1"
            style="@style/TextStyle"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:padding="5dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="2"
        android:layout_row="1"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <crc645877ad3d44b9b81b.GTProgressBar
            android:id="@+id/awayPossession"
            android:layout_width="80dp"
            android:layout_height="25dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:padding="5dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="2"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <crc645877ad3d44b9b81b.GTProgressBar
            android:id="@+id/homeShotsOnTarget"
            android:layout_width="80dp"
            android:layout_height="25dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="1"
        android:layout_row="2"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <TextView
            android:textColor="@android:color/white"
            android:id="@+id/shotsOnTargetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shots on target"
            android:maxLines="1"
            style="@style/TextStyle"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:padding="5dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="2"
        android:layout_row="2"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <crc645877ad3d44b9b81b.GTProgressBar
            android:id="@+id/awayShotsOnTarget"
            android:layout_width="80dp"
            android:layout_height="25dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:padding="5dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="3"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <crc645877ad3d44b9b81b.GTProgressBar
            android:id="@+id/homeYellowCards"
            android:layout_width="80dp"
            android:layout_height="25dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="1"
        android:layout_row="3"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <TextView
            android:textColor="@android:color/white"
            android:id="@+id/yellowCardsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yellow cards"
            android:maxLines="1"
            style="@style/TextStyle"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:padding="5dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="2"
        android:layout_row="3"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <crc645877ad3d44b9b81b.GTProgressBar
            android:id="@+id/awayYellowCards"
            android:layout_width="80dp"
            android:layout_height="25dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:padding="5dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="4"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <crc645877ad3d44b9b81b.GTProgressBar
            android:id="@+id/homeRedCards"
            android:layout_width="80dp"
            android:layout_height="25dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="1"
        android:layout_row="4"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <TextView
            android:textColor="@android:color/white"
            android:id="@+id/redCardsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Red cards"
            android:maxLines="1"
            style="@style/TextStyle"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:padding="5dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="2"
        android:layout_row="4"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <crc645877ad3d44b9b81b.GTProgressBar
            android:id="@+id/awayRedCards"
            android:layout_width="80dp"
            android:layout_height="25dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:padding="5dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="5"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <crc645877ad3d44b9b81b.GTProgressBar
            android:id="@+id/homeCorners"
            android:layout_width="80dp"
            android:layout_height="25dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="1"
        android:layout_row="5"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <TextView
            android:textColor="@android:color/white"
            android:id="@+id/cornersText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Corners"
            android:maxLines="1"
            style="@style/TextStyle"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:padding="5dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="2"
        android:layout_row="5"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1">
        <crc645877ad3d44b9b81b.GTProgressBar
            android:id="@+id/awayCorners"
            android:layout_width="80dp"
            android:layout_height="25dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="6"
        android:layout_rowWeight="3"
        android:layout_columnWeight="3"/>
</GridLayout>
