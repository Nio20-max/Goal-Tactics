<?xml version="1.0" encoding="utf-8"?>
<crc645877ad3d44b9b81b.InsetsLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:right="false">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/squad_playersContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <crc645877ad3d44b9b81b.GTTableView
            android:id="@+id/squad_PlayersTable"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="10"/>
        <crc645877ad3d44b9b81b.TabsView
            android:id="@+id/squad_DetailsTabView"
            android:background="@drawable/background_transparent_nocorners"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="25"/>
    </LinearLayout>
    <crc645877ad3d44b9b81b.NoDataView
        android:id="@+id/squad_noPlayersContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:button_1_text="@string/GoToTransfermarket"
        app:button_2_text="@string/GoToScouting"
        app:character="CoachPoint"
        app:message="@string/NoPlayersDescription"/>
</crc645877ad3d44b9b81b.InsetsLayout>
